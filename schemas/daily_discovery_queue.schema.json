{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HitterDNA Daily Discovery Queue Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["queue_id", "analysis_date", "game_pk", "player_mlbam_id", "candidate_name", "team", "opponent", "prop_family", "source_type", "trigger_type", "raw_claim", "source_url", "retrieved_at_utc", "sample_type", "sample_n", "stabilization_status", "feature_mapping", "expected_direction", "duplicate_risk", "evidence_status", "lineup_status", "market_status", "disposition"],
  "properties": {
    "queue_id": {"type": "string", "format": "uuid"},
    "analysis_date": {"type": "string", "format": "date"},
    "game_pk": {"type": ["integer", "null"], "minimum": 1},
    "player_mlbam_id": {"type": ["integer", "null"], "minimum": 1},
    "candidate_name": {"type": "string", "minLength": 1},
    "team": {"type": "string", "pattern": "^[A-Z]{2,3}$"},
    "opponent": {"type": "string", "pattern": "^[A-Z]{2,3}$"},
    "prop_family": {"type": "string", "enum": ["hit", "total_bases", "home_run", "runs", "rbi", "h_r"]},
    "source_type": {"type": "string", "enum": ["savant", "statsapi", "fangraphs", "barrellab", "market", "weather", "manual", "bvp_display"]},
    "trigger_type": {"type": "string", "enum": ["arsenal_collision", "zone_fit", "pull_air", "contact_allowed", "park_weather", "lineup_pa", "market_gap", "bvp", "other"]},
    "raw_claim": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "retrieved_at_utc": {"type": "string", "format": "date-time"},
    "sample_type": {"type": "string", "enum": ["pa", "ab", "pitches", "bip", "innings", "games", "unknown"]},
    "sample_n": {"type": "number", "minimum": 0},
    "stabilization_status": {"type": "string", "enum": ["pass", "fail", "descriptive_only", "unverified"]},
    "feature_mapping": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["hitter_baseline", "arsenal_collision", "zone_collision", "platoon_adjustment", "starter_contact_quality", "starter_workload", "park_event_factor", "weather_adjustment", "projected_pa", "runs_context", "market_price"]}},
    "feature_value": {"type": ["number", "string", "null"]},
    "expected_direction": {"type": "string", "enum": ["positive", "negative", "neutral"]},
    "duplicate_risk": {"type": "string", "enum": ["low", "medium", "high"]},
    "evidence_status": {"type": "string", "enum": ["pending", "verified", "rejected", "insufficient_sample"]},
    "lineup_status": {"type": "string", "enum": ["confirmed", "unconfirmed", "excluded"]},
    "market_status": {"type": "string", "enum": ["unpriced", "priced", "devigged", "rejected"]},
    "market_book": {"type": ["string", "null"]},
    "market_line": {"type": ["number", "string", "null"]},
    "market_price": {"type": ["number", "null"]},
    "disposition": {"type": "string", "enum": ["investigate", "advance", "hold", "drop", "archived"]},
    "review_notes": {"type": "string"}
  },
  "allOf": [{
    "if": {"properties": {"source_type": {"const": "bvp_display"}}},
    "then": {"properties": {"stabilization_status": {"const": "descriptive_only"}, "disposition": {"const": "drop"}}}
  }]
}
