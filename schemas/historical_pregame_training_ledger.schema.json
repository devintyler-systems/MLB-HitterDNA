{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HitterDNA Historical Pregame Training Ledger v0",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "target_name", "generated_at_utc", "ledger_cutoff_metadata", "row_count", "rows", "exclusion_count", "exclusions", "provenance_references", "no_probability_status", "model_publication_status"],
  "properties": {
    "artifact_type": {"const": "historical_pregame_training_ledger"}, "schema_version": {"const": "historical-pregame-training-ledger-v0"},
    "target_name": {"const": "official_hit_ge_1"}, "generated_at_utc": {"$ref": "#/$defs/utc"},
    "ledger_cutoff_metadata": {"type": "object", "additionalProperties": false, "required": ["rule", "partition_metadata"], "properties": {"rule": {"type": "string", "minLength": 1}, "partition_metadata": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "chronological_metadata_only"}}}}},
    "row_count": {"type": "integer", "minimum": 0}, "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "exclusion_count": {"type": "integer", "minimum": 0}, "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
    "provenance_references": {"type": "object", "additionalProperties": false, "required": ["schedule"], "properties": {"schedule": {"$ref": "#/$defs/provenance"}}},
    "no_probability_status": {"const": "NO_PROBABILITY_CALCULATED"}, "model_publication_status": {"const": "MODEL_NOT_IMPLEMENTED"}
  },
  "$defs": {
    "utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
    "health": {"enum": ["PASS", "STALE", "UNVERIFIED", "RETRYABLE", "TERMINAL"]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["endpoint_id", "source", "endpoint_or_url", "submitted_parameters", "retrieved_at_utc", "raw_response_hash", "canonical_keys", "source_freshness_status", "source_failure_status"], "properties": {"endpoint_id": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "endpoint_or_url": {"type": "string", "minLength": 1}, "submitted_parameters": {"type": "object"}, "retrieved_at_utc": {"$ref": "#/$defs/utc"}, "available_at_utc": {"$ref": "#/$defs/utc"}, "raw_response_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "canonical_keys": {"type": "object"}, "source_freshness_status": {"enum": ["PASS", "STALE", "UNVERIFIED"]}, "source_failure_status": {"enum": ["PASS", "UNVERIFIED", "RETRYABLE", "TERMINAL"]}}},
    "pregame_provenance": {"allOf": [{"$ref": "#/$defs/provenance"}, {"type": "object", "required": ["available_at_utc"]}]},
    "row": {"type": "object", "additionalProperties": false, "required": ["game_pk", "game_date", "season", "player_mlbam_id", "team_mlbam_id", "opponent_team_mlbam_id", "venue_mlbam_id", "opponent_starter_mlbam_id", "scheduled_first_pitch_utc", "as_of_utc", "confirmed_lineup_side", "batting_order_slot", "official_hit_ge_1", "final_label_provenance", "paired_pregame_snapshot_provenance", "source_health", "feature_construction_version", "no_probability_status", "model_publication_status"], "properties": {"game_pk": {"type": "integer", "minimum": 1}, "game_date": {"type": "string", "format": "date"}, "season": {"type": "integer", "minimum": 1900}, "player_mlbam_id": {"type": "integer", "minimum": 1}, "team_mlbam_id": {"type": "integer", "minimum": 1}, "opponent_team_mlbam_id": {"type": "integer", "minimum": 1}, "venue_mlbam_id": {"type": "integer", "minimum": 1}, "opponent_starter_mlbam_id": {"type": ["integer", "null"], "minimum": 1}, "scheduled_first_pitch_utc": {"$ref": "#/$defs/utc"}, "as_of_utc": {"$ref": "#/$defs/utc"}, "confirmed_lineup_side": {"enum": ["away", "home"]}, "batting_order_slot": {"type": "integer", "minimum": 1, "maximum": 9}, "official_hit_ge_1": {"type": "boolean"}, "final_label_provenance": {"$ref": "#/$defs/provenance"}, "paired_pregame_snapshot_provenance": {"$ref": "#/$defs/pregame_provenance"}, "source_health": {"type": "object", "additionalProperties": false, "required": ["schedule", "pregame_snapshot", "final_label"], "properties": {"schedule": {"$ref": "#/$defs/health"}, "pregame_snapshot": {"$ref": "#/$defs/health"}, "final_label": {"$ref": "#/$defs/health"}}}, "feature_construction_version": {"const": "historical-pregame-ledger-v0.1"}, "no_probability_status": {"const": "NO_PROBABILITY_CALCULATED"}, "model_publication_status": {"const": "MODEL_NOT_IMPLEMENTED"}}},
    "exclusion": {"type": "object", "additionalProperties": false, "required": ["game_pk", "player_mlbam_id", "team_side", "status", "reason"], "properties": {"game_pk": {"type": ["integer", "null"], "minimum": 1}, "player_mlbam_id": {"type": ["integer", "null"], "minimum": 1}, "team_side": {"type": ["string", "null"], "enum": ["away", "home", null]}, "status": {"$ref": "#/$defs/health"}, "reason": {"type": "string", "pattern": "^[A-Z0-9_]+$"}}}
  }
}
