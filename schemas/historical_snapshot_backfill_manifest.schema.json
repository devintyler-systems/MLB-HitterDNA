{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"HitterDNA Historical Snapshot Backfill v0 Manifest",
  "type":"object","additionalProperties":false,
  "required":["artifact_type","corpus_version","generated_at_utc","date_interval","snapshot_root_reference","games","coverage_summary","exclusions","provenance_references"],
  "properties":{
    "artifact_type":{"const":"historical_snapshot_backfill_manifest"},"corpus_version":{"type":"string","minLength":1},"generated_at_utc":{"$ref":"#/$defs/utc"},
    "date_interval":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"string","format":"date"},"end":{"type":"string","format":"date"}}},
    "snapshot_root_reference":{"type":"string","minLength":1},"games":{"type":"array","items":{"$ref":"#/$defs/game"}},
    "coverage_summary":{"type":"object","additionalProperties":false,"required":["games_offered","complete_triplets","valid_pregame_snapshots","valid_ledger_eligible_games","excluded_games_by_reason","duplicate_snapshot_conflicts","source_health_distribution"],"properties":{"games_offered":{"type":"integer","minimum":0},"complete_triplets":{"type":"integer","minimum":0},"valid_pregame_snapshots":{"type":"integer","minimum":0},"valid_ledger_eligible_games":{"type":"integer","minimum":0},"excluded_games_by_reason":{"type":"object","additionalProperties":{"type":"integer","minimum":1}},"duplicate_snapshot_conflicts":{"type":"integer","minimum":0},"source_health_distribution":{"type":"object","additionalProperties":{"type":"integer","minimum":1}}}},
    "exclusions":{"type":"array","items":{"$ref":"#/$defs/exclusion"}},"provenance_references":{"type":"array","items":{"$ref":"#/$defs/snapshot"}}
  },
  "$defs":{
    "utc":{"type":"string","format":"date-time","pattern":"(?:Z|\\+00:00)$"},
    "health_fresh":{"enum":["PASS","STALE","UNVERIFIED"]},"health_failure":{"enum":["PASS","UNVERIFIED","RETRYABLE","TERMINAL"]},
    "lineup_status":{"enum":["confirmed","unconfirmed"]},
    "provenance_fields":{"type":"object","required":["endpoint_id","source","endpoint_or_url","submitted_parameters","retrieved_at_utc","raw_response_hash","source_freshness_status","source_failure_status","canonical_keys","snapshot_path","role"],"properties":{"endpoint_id":{"type":"string","minLength":1},"source":{"type":"string","minLength":1},"endpoint_or_url":{"type":"string","minLength":1},"submitted_parameters":{"type":"object"},"retrieved_at_utc":{"$ref":"#/$defs/utc"},"raw_response_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"source_freshness_status":{"$ref":"#/$defs/health_fresh"},"source_failure_status":{"$ref":"#/$defs/health_failure"},"canonical_keys":{"type":"object","additionalProperties":false,"required":["game_pk"],"properties":{"game_pk":{"type":"integer","minimum":1}}},"snapshot_path":{"type":"string","pattern":"^(?![A-Za-z]:)(?!/)(?!\\\\).+"},"role":{"enum":["schedule","pregame_live_feed","final_box_score"]},"game_pk":{"type":"integer","minimum":1},"available_at_utc":{"$ref":"#/$defs/utc"},"outcome_only":{"const":true},"away_lineup_status":{"$ref":"#/$defs/lineup_status"},"home_lineup_status":{"$ref":"#/$defs/lineup_status"},"away_confirmed_hitter_count":{"type":"integer","minimum":0,"maximum":9},"home_confirmed_hitter_count":{"type":"integer","minimum":0,"maximum":9}},"additionalProperties":false},
    "snapshot":{"allOf":[{"$ref":"#/$defs/provenance_fields"},{"type":"object","properties":{"game_pk":{"type":"integer","minimum":1},"available_at_utc":{"$ref":"#/$defs/utc"},"outcome_only":{"const":true}},"required":["game_pk"]}],"oneOf":[{"properties":{"role":{"const":"schedule"}},"required":["game_pk"]},{"properties":{"role":{"const":"pregame_live_feed"}},"required":["game_pk","available_at_utc","away_lineup_status","home_lineup_status","away_confirmed_hitter_count","home_confirmed_hitter_count"],"allOf":[{"if":{"properties":{"away_lineup_status":{"const":"confirmed"}}},"then":{"properties":{"away_confirmed_hitter_count":{"const":9}}},"else":{"properties":{"away_confirmed_hitter_count":{"const":0}}}},{"if":{"properties":{"home_lineup_status":{"const":"confirmed"}}},"then":{"properties":{"home_confirmed_hitter_count":{"const":9}}},"else":{"properties":{"home_confirmed_hitter_count":{"const":0}}}}]},{"properties":{"role":{"const":"final_box_score"}},"required":["game_pk","outcome_only"]}]},
    "game":{"type":"object","additionalProperties":false,"required":["game_pk","game_date","scheduled_first_pitch_utc","as_of_utc","snapshots"],"properties":{"game_pk":{"type":"integer","minimum":1},"game_date":{"type":"string","format":"date"},"scheduled_first_pitch_utc":{"$ref":"#/$defs/utc"},"as_of_utc":{"$ref":"#/$defs/utc"},"snapshots":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/snapshot"},"allOf":[{"contains":{"type":"object","properties":{"role":{"const":"schedule"}},"required":["role"]}},{"contains":{"type":"object","properties":{"role":{"const":"pregame_live_feed"}},"required":["role"]}},{"contains":{"type":"object","properties":{"role":{"const":"final_box_score"}},"required":["role"]}}]}}},
    "exclusion":{"type":"object","additionalProperties":false,"required":["game_pk","status","reason","snapshot_role"],"properties":{"game_pk":{"type":["integer","null"],"minimum":1},"status":{"enum":["UNVERIFIED","STALE","RETRYABLE","TERMINAL"]},"reason":{"type":"string","pattern":"^[A-Z0-9_]+$"},"snapshot_role":{"type":["string","null"],"enum":["schedule","pregame_live_feed","final_box_score",null]}}}
  }
}

